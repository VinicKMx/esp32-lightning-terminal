FROM rust:1.95-bookworm AS builder

WORKDIR /app
COPY . .
RUN cargo build --release -p lightning-terminal-gateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/lightning-terminal-gateway /usr/local/bin/lightning-terminal-gateway

EXPOSE 3000
ENTRYPOINT ["lightning-terminal-gateway"]
